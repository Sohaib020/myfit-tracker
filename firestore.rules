rules_version = '2';
// MyFit Tracker — paste this into Firebase console → Firestore Database → Rules → Publish.
// Everyone can only write their own data; numbers must be within human limits.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isFriend(uid) { return signedIn() && exists(/databases/$(database)/documents/users/$(uid)/friends/$(request.auth.uid)); }
    // weekly totals: at most 7 days × (100k steps, 1,440 workout min, 150 km)
    function saneWeek(d) {
      return d.steps is int && d.steps >= 0 && d.steps <= 700000
        && d.activeMin is int && d.activeMin >= 0 && d.activeMin <= 10080
        && d.distanceM is number && d.distanceM >= 0 && d.distanceM <= 1050000
        && d.name is string && d.name.size() <= 24
        && (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 60))
        && (!('mascot' in d) || (d.mascot is string && d.mascot.size() <= 12))
        && d.keys().hasOnly(['name', 'color', 'steps', 'activeMin', 'distanceM', 'days', 'updatedAt', 'level', 'mascot']);
    }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    match /users/{uid} {
      // public profile: display name, colour and whether you appear on the global board — nothing else
      allow read: if signedIn();
      allow create, update: if isMe(uid) && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.keys().hasOnly(['name', 'public', 'color', 'createdAt', 'username', 'avatar'])
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 40))
        // a username must be one you own in /usernames (claimed in the same transaction)
        && (!('username' in request.resource.data) || (resource != null && request.resource.data.username == resource.data.get('username', ''))
            || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid);
      allow delete: if isMe(uid);
      // friend requests sent to this user (by @username search)
      match /requests/{from} {
        allow read: if isMe(uid);
        allow create, update: if isMe(from) && from != uid
          && !exists(/databases/$(database)/documents/users/$(uid)/blocked/$(from))
          && request.resource.data.keys().hasOnly(['name', 'username', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.username is string && request.resource.data.username.size() <= 20;
        allow delete: if isMe(uid) || isMe(from);
      }
      match /private/{doc} {
        allow read, write: if isMe(uid);
      }
      // people this user blocked (their requests are hidden and declined)
      match /blocked/{bid} {
        allow read, write: if isMe(uid);
      }
      match /friends/{fid} {
        allow read: if isMe(uid);
        // you can add someone to your own list; they appear on yours only if you hold THEIR code
        allow create: if isMe(uid)
          || (isMe(fid) && request.resource.data.code is string
              && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid
              && !exists(/databases/$(database)/documents/users/$(uid)/blocked/$(fid)))
          // accepting a friend request: uid asked fid, so fid may add themselves to uid's list
          || (isMe(fid) && exists(/databases/$(database)/documents/users/$(fid)/requests/$(uid))
              && !exists(/databases/$(database)/documents/users/$(uid)/blocked/$(fid)));
        allow delete: if isMe(uid) || isMe(fid);
      }
    }

    // unique @usernames: one doc per name, owned by one uid
    match /usernames/{name} {
      allow get: if signedIn();
      allow create: if signedIn() && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Arena profile friends can open: level, stars, reward titles, finished journeys, this week's totals
    match /arenaProfile/{uid} {
      allow read: if isMe(uid) || isFriend(uid);
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['level', 'stars', 'mascot', 'rewards', 'journeys', 'weekSteps', 'weekActiveMin', 'weekWorkouts', 'updatedAt', 'photo'])
        // optional small profile photo (base64 JPEG, ~10 KB) — friends only, like the rest of this document
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 30000))
        && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 60
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 100000
        && request.resource.data.rewards is list && request.resource.data.rewards.size() <= 30
        && request.resource.data.journeys is list && request.resource.data.journeys.size() <= 20;
      allow delete: if isMe(uid);
    }

    // blood-sugar family sharing (opt-in): code → patient; carers listed under the patient can read the readings
    match /glucoseShares/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name']) && request.resource.data.name is string && request.resource.data.name.size() <= 24;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /glucose/{uid} {
      function isCarer() { return signedIn() && exists(/databases/$(database)/documents/glucose/$(uid)/carers/$(request.auth.uid)); }
      allow read: if isMe(uid) || isCarer();
      allow write: if isMe(uid);
      match /readings/{rid} {
        allow read: if isMe(uid) || isCarer();
        allow write: if isMe(uid) && (request.resource == null || (request.resource.data.keys().hasOnly(['mgdl', 'tag', 'takenAt'])
          && request.resource.data.mgdl is number && request.resource.data.mgdl > 0 && request.resource.data.mgdl < 1000));
      }
      match /carers/{cid} {
        allow read: if isMe(uid) || isMe(cid);
        // a carer can add themselves only with the patient's family code
        allow create: if isMe(cid) && request.resource.data.code is string
          && get(/databases/$(database)/documents/glucoseShares/$(request.resource.data.code)).data.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'code']);
        allow delete: if isMe(uid) || isMe(cid);
      }
    }

    match /codes/{code} {
      allow get: if signedIn();      // look up one code; listing all codes is not allowed
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /weekly/{week}/entries/{uid} {
      allow read: if isMe(uid) || isFriend(uid);
      allow write: if isMe(uid) && saneWeek(request.resource.data);
      allow delete: if isMe(uid);
    }

    match /weeklyPublic/{week}/entries/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid) && saneWeek(request.resource.data);
      allow delete: if isMe(uid);
    }

    // Arena races: one entry per person per weekly/monthly challenge; only friends can see it
    match /arena/{cid}/members/{uid} {
      allow read: if isMe(uid) || isFriend(uid);
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'pct', 'value', 'doneAt', 'mascot', 'level', 'updatedAt'])
        && request.resource.data.pct is number && request.resource.data.pct >= 0 && request.resource.data.pct <= 10
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.doneAt is string && request.resource.data.doneAt.size() <= 10;
      allow delete: if isMe(uid);
    }

    // activity feed: my milestones, readable by me and my friends
    match /feed/{uid}/items/{id} {
      allow read: if isMe(uid) || isFriend(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['kind', 'text', 'name', 'at'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 12;
      allow delete: if isMe(uid);
    }

    match /challenges/{cid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.creator == request.auth.uid
        && request.auth.uid in request.resource.data.members && request.resource.data.members.size() <= 20
        && isDate(request.resource.data.start) && isDate(request.resource.data.end)
        && request.resource.data.metric in ['steps', 'activeMin', 'distanceM']
        && request.resource.data.title is string && request.resource.data.title.size() <= 40;
      // members may only remove themselves
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.size() == resource.data.members.size() - 1
        && !(request.auth.uid in request.resource.data.members);
      allow delete: if signedIn() && resource.data.creator == request.auth.uid;

      match /progress/{uid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.members;
        allow write: if isMe(uid) && request.auth.uid in get(/databases/$(database)/documents/challenges/$(cid)).data.members
          && request.resource.data.keys().hasAny(['steps', 'activeMin', 'distanceM'])
          && (!('steps' in request.resource.data) || (request.resource.data.steps >= 0 && request.resource.data.steps <= 3100000))
          && (!('activeMin' in request.resource.data) || (request.resource.data.activeMin >= 0 && request.resource.data.activeMin <= 43200))
          && (!('distanceM' in request.resource.data) || (request.resource.data.distanceM >= 0 && request.resource.data.distanceM <= 4500000));
      }
    }

    // reports about other users (picture, name, behaviour) — write-only for users; reviewed in the Firebase console
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter == request.auth.uid
        && request.resource.data.keys().hasOnly(['reporter', 'target', 'reason', 'details', 'at'])
        && request.resource.data.target is string && request.resource.data.target.size() <= 128
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
        && request.resource.data.details is string && request.resource.data.details.size() <= 500;
      allow read, update, delete: if false;
    }
  }
}
