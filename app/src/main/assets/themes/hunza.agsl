// Hunza Dusk: Karakoram peaks catching the last pink light, apricot horizon, poplar silhouettes, first stars
float ridge(float x, float seed) {
    float v = 0.0;
    float a = 0.5;
    float f = 1.0;
    for (int i = 0; i < 5; i++) {
        float n = noise(float2(x * f + seed, seed * 1.7));
        v += a * (1.0 - abs(n * 2.0 - 1.0));
        f *= 2.1;
        a *= 0.5;
    }
    return v;
}
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float px = 1.5 / res.y;
    // sky
    float3 top = float3(0.055, 0.055, 0.150);
    float3 mid = float3(0.36, 0.22, 0.40);
    float3 hor = float3(0.98, 0.64, 0.45);
    float3 c = mix(top, mid, smoothstep(0.05, 0.50, uv.y));
    c = mix(c, hor, smoothstep(0.42, 0.66, uv.y));
    c += float3(1.0) * stars(p * 55.0, 0.08, 0.0) * 0.55 * smoothstep(0.35, 0.0, uv.y);
    // far peaks (Rakaposhi-like), snow lit pink on the left faces
    float x1 = p.x * 2.2;
    float h1 = 0.66 - 0.26 * ridge(x1, 3.0) + 0.04 * sin(p.x * 3.0);
    float e = 0.02;
    // smooth slope from a low-octave copy of the ridge, so lighting reads as broad faces, not streaks
    float hs0 = 0.30 * (noise(float2(x1 + 3.0, 5.1)) + 0.5 * noise(float2(x1 * 2.1 + 3.0, 5.1)));
    float hs1 = 0.30 * (noise(float2(x1 + e * 2.2 + 3.0, 5.1)) + 0.5 * noise(float2((x1 + e * 2.2) * 2.1 + 3.0, 5.1)));
    float slope = (hs0 - hs1) / e;
    float m1 = smoothstep(h1 - px, h1 + px, uv.y);
    float below = uv.y - h1;
    float snowLine = 0.035 + 0.05 * smoothstep(0.50, 0.36, h1) + 0.02 * fbm3(p * 14.0);
    float snow = smoothstep(snowLine, snowLine * 0.6, below) * smoothstep(0.54, 0.44, h1 + below * 0.5);
    float lit = clamp(0.5 + slope * 0.9, 0.0, 1.0);
    float3 rock = mix(float3(0.28, 0.20, 0.32), float3(0.40, 0.27, 0.37), lit);
    float3 snowc = mix(float3(0.60, 0.50, 0.66), float3(1.0, 0.80, 0.76), lit);
    float3 far = mix(rock, snowc, snow * 0.9);
    far = mix(far, hor * 0.7, smoothstep(0.62, 0.72, uv.y) * 0.5);   // valley haze
    c = mix(c, far, m1);
    // nearer ridge
    float h2 = 0.74 - 0.12 * ridge(p.x * 3.5, 11.0);
    float m2 = smoothstep(h2 - px, h2 + px, uv.y);
    c = mix(c, mix(float3(0.16, 0.12, 0.22), float3(0.10, 0.08, 0.15), smoothstep(h2, 1.0, uv.y)), m2);
    // foreground terraces and poplars
    float h3 = 0.88 - 0.03 * sin(p.x * 4.0 + 1.0);
    float m3 = smoothstep(h3 - px, h3 + px, uv.y);
    float tree = 0.0;
    float tw = 0.045;
    float ti = floor(p.x / tw);
    float th = 0.06 + 0.07 * hash(float2(ti, 4.0));
    float tx = (fract(p.x / tw) - 0.5) * tw;
    float ty = (h3 - uv.y) / th;                    // 0 at base, 1 at tip
    float wdt = 0.0085 * sqrt(max(sin(3.14159 * clamp(ty, 0.0, 1.0)), 0.0)) * (1.0 - 0.35 * ty);
    tree = step(abs(tx), wdt) * step(0.0, ty) * step(ty, 1.0) * step(hash(float2(ti, 9.0)), 0.75);
    c = mix(c, float3(0.040, 0.035, 0.060), max(m3, tree));
    float2 vv = uv - float2(0.5, 0.45);
    c *= 1.0 - 0.35 * dot(vv, vv);
    c += (hash(fc + 5.5) - 0.5) * 0.012;
    return outc(c);
}
