// Frost light: soft iridescent pastel liquid gradient (light theme)
half4 main(float2 fc) {
    float2 uv = fc / res.y;
    float tt = t * 0.06;
    float2 w = float2(fbm3(uv * 1.4 + tt), fbm3(uv * 1.4 - tt + 3.3));
    float f = fbm3(uv * 1.2 + 2.2 * w + tt);
    float3 a = float3(1.0, 0.70, 0.76);
    float3 b = float3(0.74, 0.70, 1.0);
    float3 d = float3(0.62, 0.86, 1.0);
    float3 e = float3(1.0, 0.86, 0.66);
    float3 c = mix(mix(a, b, smoothstep(0.25, 0.65, f)), mix(d, e, smoothstep(0.3, 0.75, w.x)), smoothstep(0.35, 0.7, w.y));
    c = mix(c, float3(0.98, 0.98, 0.99), 0.22);
    c += 0.08 * pow(smoothstep(0.6, 0.9, f), 2.0);
    return outc(c);
}
