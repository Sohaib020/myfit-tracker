// Neon city: synthwave sun, skyline silhouettes, scrolling neon grid
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float hz = 0.6;
    float3 c = mix(float3(0.07, 0.01, 0.2), float3(0.55, 0.05, 0.42), smoothstep(0.0, hz, uv.y));
    c += float3(1.0) * stars(fc / res.y * 60.0, 0.15, 2.0) * (1.0 - uv.y / hz) * 0.7;
    // sun with stripes
    float2 sp = (uv - float2(0.5, hz - 0.12)) * float2(ar, 1.0);
    float sd = length(sp);
    float stripes = step(0.5, fract((uv.y - t * 0.02) * 40.0)) + step(uv.y, hz - 0.17);
    float sun = smoothstep(0.2, 0.195, sd) * clamp(stripes, 0.0, 1.0);
    c = mix(c, mix(float3(1.0, 0.85, 0.3), float3(1.0, 0.2, 0.6), smoothstep(-0.2, 0.2, sp.y)), sun);
    c += float3(1.0, 0.3, 0.6) * exp(-sd * 5.0) * 0.35;
    // skyline
    float bx = floor(uv.x * 22.0);
    float bh = hz - 0.02 - 0.12 * hash(float2(bx, 3.0)) * hash(float2(bx, 7.0) + 1.0);
    if (uv.y > bh && uv.y < hz) {
        c = float3(0.05, 0.0, 0.1);
        float2 w = fract(float2(uv.x * 22.0 * 4.0, uv.y * 120.0));
        float lit = step(0.6, hash(floor(float2(uv.x * 88.0, uv.y * 120.0)) + floor(t * 0.3)));
        c += float3(1.0, 0.4, 0.8) * lit * step(0.3, w.x) * step(0.4, w.y) * 0.5;
    }
    if (uv.y >= hz) {
        float d = (uv.y - hz) / (1.0 - hz);
        float z = 1.0 / max(d, 0.03);
        float x = (uv.x - 0.5) * z * 3.0;
        float gz = fract(z * 0.6 + t * 0.5);
        float gx = fract(x);
        float l = max(smoothstep(0.08, 0.0, min(gz, 1.0 - gz) / z * 6.0), smoothstep(0.06, 0.0, min(gx, 1.0 - gx) / z * 3.0));
        c = mix(float3(0.06, 0.0, 0.12), float3(0.9, 0.1, 0.8), l * (0.4 + d));
        c += float3(0.9, 0.2, 0.7) * exp(-d * 6.0) * 0.4;
    }
    return outc(c);
}
