// Midnight rain: blurred city bokeh behind glass with sliding raindrops
half4 main(float2 fc) {
    float2 uv = fc / res.y;
    float v = fc.y / res.y;
    float3 c = mix(float3(0.04, 0.06, 0.14), float3(0.01, 0.02, 0.05), v);
    // bokeh lights
    for (int L = 0; L < 2; L++) {
        float fl = float(L);
        float2 p = uv * (4.0 + fl * 3.0) + float2(t * 0.02 * (fl + 1.0), fl * 3.0);
        float2 i = floor(p);
        float2 f = fract(p) - 0.5;
        float h = hash(i + fl);
        float2 o = (hash2(i + 9.0) - 0.5) * 0.3;
        float r = 0.17 + 0.12 * h;
        float b = smoothstep(r, r * 0.6, length(f - o)) * step(0.45, h);
        float3 bc = mix(float3(1.0, 0.65, 0.3), float3(0.4, 0.6, 1.0), hash(i + 5.0));
        c += bc * b * (0.18 + 0.1 * sin(t * 0.5 + h * 20.0)) * smoothstep(1.0, 0.3, v);
    }
    // raindrops sliding down glass
    float2 p = uv * float2(14.0, 3.0);
    float col = floor(p.x);
    float h = hash(float2(col, 1.0));
    float y = fract(p.y * 0.35 + t * (0.15 + h * 0.25) + h * 10.0);
    float2 f = float2(fract(p.x) - 0.5 + 0.05 * sin(p.y * 6.0 + h * 10.0), y - 0.5);
    float drop = smoothstep(0.08, 0.03, length(f * float2(1.0, 2.4)));
    float trail = smoothstep(0.04, 0.0, abs(f.x)) * smoothstep(-0.5, 0.0, -f.y) * step(0.0, f.y) * 0.25;
    c += float3(0.7, 0.8, 1.0) * (drop * 0.6 + trail) * step(0.3, h);
    // static droplets
    float2 sp = uv * 26.0;
    float2 si = floor(sp);
    float sh = hash(si);
    float sd = length(fract(sp) - 0.5 - (hash2(si) - 0.5) * 0.5);
    c += float3(0.6, 0.75, 1.0) * smoothstep(0.12, 0.05, sd) * step(0.8, sh) * 0.35;
    return outc(c);
}
