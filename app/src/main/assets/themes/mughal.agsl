// Mughal Tiles: deep lapis kashi tilework — an eight-point star (khatam) lattice in ochre gold, turquoise stars
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float px = 1.5 / res.y;
    float3 c = mix(float3(0.040, 0.065, 0.150), float3(0.020, 0.032, 0.080), uv.y);
    float s = 0.17;
    float2 q = (fract(p / s + float2(0.5, 0.25)) - 0.5) * s;
    float2 aq = abs(q);
    float sq = max(aq.x, aq.y);
    float rq = (aq.x + aq.y) * 0.70710678;
    float r = 0.33 * s;
    float star = min(sq, rq) - r;                 // 8-point star (two overlapping squares)
    float oct = max(sq, rq) - r * 0.62;            // inner octagon
    float lw = 0.0018;
    float l1 = smoothstep(lw + px, lw - px, abs(star));
    float l2 = smoothstep(lw * 0.7 + px, lw * 0.7 - px, abs(oct));
    float inStar = smoothstep(px, -px, star);
    float inOct = smoothstep(px, -px, oct);
    // the space between stars forms crosses; tint it warm terracotta
    float3 tile = mix(float3(0.30, 0.13, 0.08), float3(0.05, 0.40, 0.45), inStar);
    tile = mix(tile, float3(0.06, 0.11, 0.26), inOct);
    // pattern visibility: rich at the top and bottom edges, quiet behind cards
    float m = 0.06 + 0.60 * smoothstep(0.26, 0.0, uv.y) + 0.50 * smoothstep(0.62, 1.0, uv.y);
    float glaze = 0.85 + 0.15 * noise(p * 30.0);
    c = mix(c, tile * glaze, m * 0.55);
    float3 gold = float3(0.86, 0.66, 0.30);
    c = mix(c, gold, max(l1, l2 * 0.7) * (0.12 + 0.75 * m));
    // lamp glow from the top
    float2 g = p - float2(ar * 0.5, -0.05);
    c += float3(0.30, 0.42, 0.65) * exp(-dot(g, g) * 3.5) * 0.10;
    float2 vv = uv - float2(0.5, 0.5);
    c *= 1.0 - 0.45 * dot(vv, vv);
    c += (hash(fc + 2.2) - 0.5) * 0.012;
    return outc(c);
}
