// Midnight Cobalt: deep navy, soft cobalt light sweeping from the top, fine pinstripe texture
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.035, 0.055, 0.13), float3(0.012, 0.018, 0.045), smoothstep(0.0, 1.0, uv.y));
    float2 g1 = float2(ar * 0.15, -0.05);
    float r1 = length(p - g1);
    c += float3(0.16, 0.38, 1.0) * exp(-r1 * r1 * 3.2) * 0.42;
    float2 g2 = float2(ar * 1.05, 0.62);
    float r2 = length(p - g2);
    c += float3(0.30, 0.20, 0.85) * exp(-r2 * r2 * 5.0) * 0.20;
    float w = fbm3(p * 2.2 + 4.0);
    c += float3(0.10, 0.22, 0.6) * smoothstep(0.45, 0.8, w) * 0.10 * (1.0 - uv.y);
    float d = p.x * 0.6 + p.y * 0.8;
    float pin = smoothstep(0.08, 0.0, 0.5 - abs(fract(d * 70.0) - 0.5));
    c += float3(0.5, 0.65, 1.0) * pin * 0.018;
    float2 vv = uv - float2(0.5, 0.4);
    c *= 1.0 - 0.55 * dot(vv, vv);
    c += (hash(fc + 1.3) - 0.5) * 0.012;
    return outc(c);
}
