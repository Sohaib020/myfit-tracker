// Aurora Night: star-filled polar sky, folded green-to-violet aurora curtains, dark mountain ridge
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.010, 0.018, 0.045), float3(0.018, 0.035, 0.065), uv.y);
    c += float3(0.85, 0.9, 1.0) * stars(p * 70.0, 0.22, 0.0) * 0.55 * (1.0 - uv.y * 0.6);
    c += float3(0.85, 0.9, 1.0) * stars(p * 28.0 + 3.0, 0.06, 0.0) * 0.6 * (1.0 - uv.y);
    // curtain 1 (main, green), folded diagonal sweep
    float y1 = 0.42 - p.x * 0.35 + 0.06 * sin(p.x * 9.0 + 1.0) + 0.08 * (fbm3(float2(p.x * 3.0, 2.0)) - 0.5);
    float d1 = uv.y - y1;
    float st1 = 0.45 + 0.55 * noise(float2(p.x * 40.0 + y1 * 30.0, 0.5));
    float pulse = 0.4 + 0.6 * smoothstep(0.25, 0.7, noise(float2(p.x * 4.0, 3.0)));
    float rib1 = exp(min(d1, 0.0) * 7.0) * smoothstep(0.03, -0.01, d1) * st1 * pulse;
    float3 col1 = mix(float3(0.20, 0.95, 0.55), float3(0.55, 0.35, 1.0), clamp(-d1 * 3.5, 0.0, 1.0));
    c += col1 * rib1 * 0.60;
    // curtain 2 (higher, violet)
    float y2 = 0.22 - p.x * 0.20 + 0.05 * sin(p.x * 7.0 + 4.0) + 0.06 * (fbm3(float2(p.x * 2.5, 7.0)) - 0.5);
    float d2 = uv.y - y2;
    float st2 = 0.5 + 0.5 * noise(float2(p.x * 30.0 + 9.0, 1.5));
    float rib2 = exp(min(d2, 0.0) * 10.0) * smoothstep(0.02, -0.01, d2) * st2;
    c += mix(float3(0.30, 0.85, 0.75), float3(0.70, 0.40, 1.0), clamp(-d2 * 5.0, 0.0, 1.0)) * rib2 * 0.28;
    c += float3(0.05, 0.25, 0.18) * exp(-d1 * d1 * 25.0) * 0.20;
    // mountain ridge
    float ridge = 0.80 + 0.07 * fbm(float2(p.x * 2.5, 1.0)) - 0.06 * abs(sin(p.x * 3.0 + 0.5));
    float m = smoothstep(ridge - 0.003, ridge + 0.003, uv.y);
    c = mix(c, mix(float3(0.050, 0.070, 0.100), float3(0.008, 0.010, 0.018), smoothstep(ridge, 1.0, uv.y)), m);
    float2 vv = uv - float2(0.5, 0.4);
    c *= 1.0 - 0.45 * dot(vv, vv);
    c += (hash(fc + 8.3) - 0.5) * 0.010;
    return outc(c);
}
