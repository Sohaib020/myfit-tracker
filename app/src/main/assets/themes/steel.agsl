// Arctic Steel: cool blue-grey, frosted light bands, crisp and calm
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.13, 0.17, 0.22), float3(0.045, 0.060, 0.085), smoothstep(0.0, 1.0, uv.y));
    float r1 = length(p - float2(ar * 0.85, 0.02));
    c += float3(0.55, 0.80, 1.0) * exp(-r1 * r1 * 4.0) * 0.22;
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float d = p.y - 0.25 - fi * 0.22 + (p.x - ar * 0.5) * (0.35 + fi * 0.08);
        c += float3(0.6, 0.8, 1.0) * exp(-d * d * 260.0) * (0.05 - fi * 0.012);
    }
    c += (fbm3(p * 2.5) - 0.5) * 0.03;
    float2 vv = uv - float2(0.5, 0.4);
    c *= 1.0 - 0.5 * dot(vv, vv);
    c += (hash(fc + 8.8) - 0.5) * 0.01;
    return outc(c);
}
