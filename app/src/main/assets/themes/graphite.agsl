// Graphite: monochrome charcoal with a brushed-metal sheen and a soft studio light
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.085, 0.088, 0.095), float3(0.028, 0.029, 0.033), smoothstep(0.0, 1.0, uv.y));
    float2 g = float2(ar * 0.7, 0.0);
    float r = length(p - g);
    c += float3(0.9, 0.92, 1.0) * exp(-r * r * 4.0) * 0.12;
    float brush = noise(float2(p.x * 3.0, p.y * 260.0)) * 0.5 + noise(float2(p.x * 7.0, p.y * 520.0)) * 0.5;
    c += (brush - 0.5) * 0.028;
    float sheen = exp(-pow(abs(p.x - p.y * 0.35 - ar * 0.55) / 0.22, 2.0));
    c += float3(0.85, 0.88, 0.95) * sheen * 0.05 * (1.0 - uv.y * 0.6);
    float2 vv = uv - float2(0.5, 0.42);
    c *= 1.0 - 0.6 * dot(vv, vv);
    c += (hash(fc + 2.1) - 0.5) * 0.010;
    return outc(c);
}
