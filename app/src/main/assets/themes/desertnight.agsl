// Desert night: starry sky, glowing moon, dune silhouettes and shooting stars
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float3 c = mix(float3(0.02, 0.03, 0.12), float3(0.12, 0.08, 0.2), uv.y);
    c += float3(1.0, 0.95, 0.85) * stars(fc / res.y * 80.0, 0.3, 2.0) * 0.9;
    // milky way band
    float band = exp(-abs(uv.y - 0.3 - 0.25 * (uv.x - 0.5)) * 10.0);
    c += float3(0.5, 0.45, 0.7) * fbm(fc / res.y * 6.0) * band * 0.4;
    // moon
    float2 mp = (uv - float2(0.75, 0.16)) * float2(ar, 1.0);
    float md = length(mp);
    c += float3(1.0, 0.9, 0.7) * exp(-md * 10.0) * 0.4;
    c = mix(c, float3(1.0, 0.95, 0.82) * (0.9 + 0.1 * fbm3(mp * 30.0)), smoothstep(0.052, 0.048, md));
    // shooting star every ~7s
    float cyc = fract(t / 7.0);
    float2 s0 = float2(0.2 + 0.5 * hash(float2(floor(t / 7.0), 1.0)), 0.08);
    float2 sp = s0 + float2(0.5, 0.25) * cyc;
    float2 dv = normalize(float2(0.5, 0.25));
    float2 rel = (uv - sp) * float2(ar, 1.0);
    float along = dot(rel, dv);
    float perp = abs(rel.x * dv.y - rel.y * dv.x);
    c += float3(1.0) * smoothstep(0.003, 0.0, perp) * smoothstep(-0.15, 0.0, along) * step(along, 0.0) * smoothstep(0.3, 0.0, cyc) * 1.5;
    for (int i = 0; i < 3; i++) {
        float fi = float(i);
        float x = uv.x * ar * (1.0 + fi * 0.6) + fi * 2.0;
        float h = 0.66 + fi * 0.1 - 0.05 * sin(x * 2.2) - 0.02 * sin(x * 5.0);
        if (uv.y > h) c = mix(float3(0.14, 0.1, 0.22), float3(0.03, 0.02, 0.06), fi / 2.0) + float3(0.25, 0.2, 0.3) * (0.03 * (1.0 - fi / 2.0));
    }
    return outc(c);
}
