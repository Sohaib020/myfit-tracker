// Lavender Mist (light): pastel lilac haze with soft pink and sky accents
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.965, 0.950, 0.995), float3(0.910, 0.885, 0.975), uv.y);
    float r1 = length(p - float2(ar * 0.9, 0.1));
    c = mix(c, float3(0.86, 0.78, 1.0), exp(-r1 * r1 * 3.0) * 0.6);
    float r2 = length(p - float2(ar * 0.05, 0.55));
    c = mix(c, float3(1.0, 0.84, 0.92), exp(-r2 * r2 * 3.5) * 0.45);
    float r3 = length(p - float2(ar * 0.7, 1.0));
    c = mix(c, float3(0.80, 0.88, 1.0), exp(-r3 * r3 * 3.0) * 0.4);
    float2 w = float2(fbm3(p * 1.3), fbm3(p * 1.3 + 5.0));
    c += (fbm3(p * 1.5 + 2.0 * w) - 0.5) * 0.04;
    c += (hash(fc + 3.3) - 0.5) * 0.008;
    return outc(c);
}
