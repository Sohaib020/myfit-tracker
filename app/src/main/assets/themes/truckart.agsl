// Truck Art: deep lacquer navy with Pakistani truck-art borders — scalloped bands, chevrons, mirror dots, a rosette
float3 tpal(float i) {
    float k = mod(i, 5.0);
    if (k < 1.0) return float3(0.91, 0.27, 0.49);   // pink
    if (k < 2.0) return float3(0.97, 0.77, 0.19);   // marigold
    if (k < 3.0) return float3(0.18, 0.64, 0.42);   // green
    if (k < 4.0) return float3(0.84, 0.23, 0.18);   // red
    return float3(0.18, 0.44, 0.84);                // blue
}
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float px = 1.5 / res.y;
    float3 c = mix(float3(0.035, 0.045, 0.090), float3(0.020, 0.024, 0.050), uv.y);
    // soft lacquer sheen
    float2 sh = p - float2(ar * 0.2, 0.35);
    c += float3(0.10, 0.12, 0.25) * exp(-dot(sh, sh) * 3.0) * 0.35;

    float3 art = float3(0.0);
    float a = 0.0;
    // ---- top border ----
    // solid ribbon with thin gold lines
    float rib = step(p.y, 0.030);
    art = mix(art, float3(0.62, 0.10, 0.20), rib); a = max(a, rib);
    float gl = smoothstep(px * 1.5, 0.0, abs(p.y - 0.032) - 0.0012);
    art = mix(art, float3(0.97, 0.78, 0.30), gl); a = max(a, gl);
    // scallops hanging from the ribbon
    float w = 0.072;
    float ci = floor(p.x / w);
    float2 sc = float2((ci + 0.5) * w, 0.034);
    float sr = length(p - sc);
    float sca = smoothstep(w * 0.5 + px, w * 0.5 - px, sr) * step(sc.y, p.y);
    float inner = smoothstep(w * 0.30 + px, w * 0.30 - px, sr);
    float dotc = smoothstep(w * 0.11 + px, w * 0.11 - px, length(p - sc - float2(0.0, w * 0.18)));
    float3 scol = mix(tpal(ci), tpal(ci + 2.0), inner);
    scol = mix(scol, float3(0.98, 0.95, 0.88), dotc);
    art = mix(art, scol, sca); a = max(a, sca);
    // mirror-chip dots under the scallops
    float dy = 0.034 + w * 0.5 + 0.016;
    float2 dg = float2(fract(p.x / (w * 0.5)) - 0.5, (p.y - dy) / (w * 0.5));
    float md = smoothstep(0.20, 0.12, length(dg));
    art = mix(art, float3(0.92, 0.94, 1.0), md); a = max(a, md * 0.9);
    // ---- bottom border: chevron stripes ----
    float by = 0.885;
    float inB = step(by, p.y);
    float cw = 0.09;
    float zz = abs(fract(p.x / cw) - 0.5) * cw;           // 0..cw/2
    float yy = (p.y - by) + zz * 0.9;
    float si = floor(yy / 0.022);
    float3 ccol = tpal(si + 1.0);
    float sline = smoothstep(px * 1.5, 0.0, abs(fract(yy / 0.022) - 0.5) * 0.022 - 0.0095);
    ccol = mix(ccol, float3(0.06, 0.05, 0.10), 1.0 - sline);
    art = mix(art, ccol, inB); a = max(a, inB);
    float bl = smoothstep(px * 1.5, 0.0, abs(p.y - by + 0.006) - 0.0012);
    art = mix(art, float3(0.97, 0.78, 0.30), bl); a = max(a, bl);
    // ---- rosette peeking from the lower right, above the chevrons ----
    float2 rq = p - float2(ar * 0.98, 0.80);
    float rr = length(rq);
    float ang = atan(rq.y, rq.x);
    float pet = 0.15 * (0.55 + 0.45 * abs(cos(ang * 4.0)));
    float pet2 = 0.10 * (0.55 + 0.45 * abs(cos(ang * 4.0 + 0.785)));
    float r1 = smoothstep(pet + px, pet - px, rr);
    float r2 = smoothstep(pet2 + px, pet2 - px, rr);
    float r3 = smoothstep(0.035 + px, 0.035 - px, rr);
    float3 rcol = mix(mix(tpal(0.0), tpal(1.0), r2), tpal(4.0), r3);
    float rim = smoothstep(px * 2.0, 0.0, abs(rr - pet) - 0.0015);
    rcol = mix(rcol, float3(0.98, 0.92, 0.75), rim);
    art = mix(art, rcol, r1 * (1.0 - inB)); a = max(a, r1 * (1.0 - inB) * 0.75);
    // matching rosette at the top left, smaller, below the scallops
    float2 rq2 = p - float2(ar * 0.02, 0.17);
    float rr2 = length(rq2);
    float ang2 = atan(rq2.y, rq2.x);
    float pe = 0.075 * (0.55 + 0.45 * abs(cos(ang2 * 3.0)));
    float s1 = smoothstep(pe + px, pe - px, rr2);
    float s2 = smoothstep(0.022 + px, 0.022 - px, rr2);
    art = mix(art, mix(tpal(2.0), tpal(1.0), s2), s1); a = max(a, s1 * 0.6);

    // painted texture and a tasteful mute
    float wear = 0.85 + 0.15 * noise(p * 60.0);
    c = mix(c, art * 0.80 * wear, a * 0.85);
    float2 vv = uv - float2(0.5, 0.5);
    c *= 1.0 - 0.35 * dot(vv, vv);
    c += (hash(fc + 1.9) - 0.5) * 0.012;
    return outc(c);
}
