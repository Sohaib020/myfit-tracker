// Lava lamp: glowing molten blobs rising and merging
half4 main(float2 fc) {
    float2 uv = fc / res.y;
    float ar = res.x / res.y;
    float field = 0.0;
    for (int i = 0; i < 8; i++) {
        float fi = float(i);
        float sp = 0.025 + 0.025 * hash(float2(fi, 1.0));
        float y = 1.0 - fract(t * sp + hash(float2(fi, 2.0)));
        y = y * 1.4 - 0.2;
        float x = ar * (0.12 + 0.76 * hash(float2(fi, 3.0))) + 0.06 * sin(t * 0.3 + fi);
        float r = 0.055 + 0.05 * hash(float2(fi, 4.0));
        float2 dd = uv - float2(x, y);
        dd.y *= 0.85 + 0.25 * sin(t * 0.5 + fi);
        field += r * r / max(dot(dd, dd), 0.0001);
    }
    float v = fc.y / res.y;
    float3 bg = mix(float3(0.20, 0.03, 0.06), float3(0.05, 0.0, 0.02), v);
    float m = smoothstep(0.95, 1.15, field);
    float3 lava = mix(float3(1.0, 0.28, 0.06), float3(1.0, 0.72, 0.28), smoothstep(1.3, 4.0, field));
    float3 c = mix(bg, lava, m);
    c += float3(1.0, 0.25, 0.05) * smoothstep(0.25, 0.95, field) * 0.3 * (1.0 - m);
    c += float3(1.0, 0.4, 0.1) * exp(-(1.0 - v) * 6.0) * 0.25;
    return outc(c);
}
