// Cosmic: deep space with a violet-magenta nebula, teal dust cloud and layered starfield
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.014, 0.012, 0.040), float3(0.006, 0.006, 0.018), uv.y);
    float2 w = p * 2.4 + float2(fbm3(p * 2.0 + 1.0), fbm3(p * 2.0 + 6.0)) * 1.2;
    float n = fbm(w);
    float n2 = fbm(w * 1.7 + 4.0);
    // violet core upper right, magenta rim
    float ra = length(p - float2(ar * 0.80, 0.24));
    float ga = exp(-ra * ra * 5.0);
    c += float3(0.42, 0.14, 0.70) * ga * (0.35 + 1.2 * n * n) * 0.55;
    c += float3(0.95, 0.30, 0.62) * ga * smoothstep(0.45, 0.75, n) * 0.55;
    // teal cloud lower left
    float rb = length(p - float2(ar * 0.10, 0.72));
    float gb = exp(-rb * rb * 6.0);
    c += float3(0.08, 0.42, 0.55) * gb * (0.3 + 1.2 * n2 * n2) * 0.45;
    // dark dust filaments
    c *= 1.0 - smoothstep(0.55, 0.75, fbm3(w * 1.3 + 9.0)) * 0.3 * (ga + gb);
    // stars
    c += float3(0.85, 0.88, 1.0) * stars(p * 110.0, 0.30, 0.0) * 0.45;
    c += float3(0.95, 0.92, 1.0) * stars(p * 50.0 + 4.0, 0.12, 0.0) * 0.7;
    float2 bs = p - float2(ar * 0.70, 0.30);
    c += float3(0.9, 0.9, 1.0) * exp(-dot(bs, bs) * 9000.0) * 0.6 + float3(0.6, 0.5, 1.0) * exp(-dot(bs, bs) * 400.0) * 0.08;
    float2 vv = uv - float2(0.5, 0.4);
    c *= 1.0 - 0.45 * dot(vv, vv);
    c += (hash(fc + 7.2) - 0.5) * 0.010;
    return outc(c);
}
