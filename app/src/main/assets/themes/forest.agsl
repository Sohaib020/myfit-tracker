// Misty forest: layered pine silhouettes, rolling fog, light shafts and fireflies
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float3 c = mix(float3(0.62, 0.80, 0.72), float3(0.10, 0.24, 0.18), uv.y);
    float2 d = uv - float2(0.72, -0.1);
    float ang = atan(d.x, d.y);
    c += float3(0.95, 1.0, 0.85) * pow(fbm3(float2(ang * 7.0, t * 0.05)), 3.0) * 0.55 * (1.0 - uv.y);
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float n = 4.0 + fi * 2.5;
        float x = uv.x * n + fi * 0.37 + sin(t * 0.1 + fi) * 0.01;
        float cell = floor(x);
        float fx = fract(x) - 0.5;
        float th = hash(float2(cell, fi + 1.0));
        float top = 0.30 + fi * 0.13 + th * 0.07;
        float dy = (uv.y - top) * n / ar * 0.5;
        float tier = 0.75 + 0.25 * fract(dy * 3.2);
        float hw = min(dy * 0.42 * tier, 0.48);
        float tree = step(0.0, dy) * step(abs(fx), hw);
        float3 tc = mix(float3(0.38, 0.55, 0.48), float3(0.03, 0.09, 0.06), fi / 3.0);
        c = mix(c, tc, tree);
        float fog = fbm3(float2(uv.x * ar * 2.0 + t * 0.03 * (fi + 1.0), uv.y * 5.0 + fi));
        c = mix(c, float3(0.75, 0.88, 0.82), smoothstep(0.45, 0.8, fog) * 0.25 * smoothstep(top, top + 0.25, uv.y));
    }
    float2 fp = fc / res.y * 12.0 + float2(sin(t * 0.3) * 0.6, cos(t * 0.25) * 0.6);
    c += float3(0.85, 1.0, 0.5) * stars(fp, 0.08, 1.5) * 1.4 * smoothstep(0.55, 0.9, uv.y);
    return outc(c);
}
