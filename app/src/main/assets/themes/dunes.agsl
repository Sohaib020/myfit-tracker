// Sunset dunes: warm sky, low sun, layered dunes with drifting sand and heat shimmer
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float shimmer = 0.004 * sin(uv.y * 120.0 + t * 3.0) * smoothstep(0.4, 0.6, uv.y);
    uv.x += shimmer;
    float3 c = mix(float3(0.98, 0.5, 0.36), float3(1.0, 0.82, 0.5), smoothstep(0.0, 0.48, uv.y));
    float2 sp = (uv - float2(0.62, 0.42)) * float2(ar, 1.0);
    c += float3(1.0, 0.9, 0.6) * exp(-length(sp) * 7.0) * 0.9;
    c = mix(c, float3(1.0, 0.95, 0.8), smoothstep(0.06, 0.05, length(sp)));
    for (int i = 0; i < 4; i++) {
        float fi = float(i);
        float base = 0.46 + fi * 0.13;
        float x = uv.x * ar * (1.2 + fi * 0.5) + fi * 3.0 + t * 0.004 * (fi + 1.0);
        float h = base - 0.06 * sin(x * 2.0) - 0.03 * sin(x * 4.3 + 1.0);
        if (uv.y > h) {
            float3 lit = mix(float3(0.95, 0.6, 0.35), float3(0.6, 0.3, 0.17), fi / 3.0);
            float3 shade = lit * 0.6;
            float slope = cos(x * 2.0) * 0.5 + 0.5;
            float3 dc = mix(shade, lit, slope);
            float ripple = sin((uv.y - h) * 400.0 + x * 20.0) * 0.5 + 0.5;
            dc *= 0.95 + 0.07 * ripple;
            c = dc;
        }
    }
    // blowing sand streaks
    float sand = fbm3(float2(uv.x * ar * 8.0 - t * 0.6, uv.y * 40.0));
    c += float3(1.0, 0.85, 0.6) * smoothstep(0.62, 0.8, sand) * 0.12 * smoothstep(0.45, 1.0, uv.y);
    return outc(c);
}
