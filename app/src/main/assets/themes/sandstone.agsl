// Sandstone (light): warm cream with soft terracotta and clay light, paper grain
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.985, 0.962, 0.925), float3(0.945, 0.900, 0.840), uv.y);
    float r1 = length(p - float2(ar * 0.95, 0.05));
    c = mix(c, float3(0.98, 0.78, 0.64), exp(-r1 * r1 * 3.2) * 0.55);
    float r2 = length(p - float2(ar * 0.0, 0.78));
    c = mix(c, float3(0.93, 0.80, 0.68), exp(-r2 * r2 * 3.0) * 0.45);
    // gentle dune contours
    float h = uv.y - 0.82 - 0.04 * sin(p.x * 3.0 + 1.2) - 0.02 * sin(p.x * 7.0);
    c = mix(c, float3(0.90, 0.76, 0.63), smoothstep(0.0, 0.25, h) * 0.35);
    float h2 = uv.y - 0.9 - 0.03 * sin(p.x * 4.0 + 3.0);
    c = mix(c, float3(0.84, 0.66, 0.52), smoothstep(0.0, 0.2, h2) * 0.3);
    c += (noise(fc * 0.35) - 0.5) * 0.02;
    c += (hash(fc + 7.7) - 0.5) * 0.01;
    return outc(c);
}
