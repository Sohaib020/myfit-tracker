// Crimson silk: domain-warped flowing folds of red light
half4 main(float2 fc) {
    float2 uv = fc / res.y;
    float tt = t * 0.07;
    float2 q = float2(fbm3(uv * 1.4 + float2(0.0, tt)), fbm3(uv * 1.4 + float2(5.2, -tt)));
    float2 r = float2(fbm3(uv * 1.3 + 3.2 * q + float2(1.7, 9.2) + tt), fbm3(uv * 1.3 + 3.2 * q + float2(8.3, 2.8) - tt));
    float f = fbm(uv * 1.1 + 2.8 * r);
    f = clamp((f - 0.22) * 3.6, 0.0, 1.0);
    float3 c = float3(0.08, 0.005, 0.012);
    c += float3(0.85, 0.05, 0.09) * pow(f, 1.6) * 1.1;
    c += float3(0.45, 0.0, 0.12) * smoothstep(0.25, 0.5, q.y) * 0.4;
    c += float3(1.0, 0.42, 0.36) * pow(smoothstep(0.55, 1.0, f), 3.0) * 0.9;
    float2 vv = fc / res - float2(0.5, 0.4);
    c *= 1.0 - 0.9 * dot(vv, vv);
    return outc(c);
}
