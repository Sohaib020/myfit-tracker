// Mint breeze: cool flowing mint liquid with floating soft bubbles (light theme)
half4 main(float2 fc) {
    float2 uv = fc / res.y;
    float tt = t * 0.06;
    float2 w = float2(fbm3(uv * 1.5 + tt), fbm3(uv * 1.5 - tt + 2.0));
    float f = clamp((fbm3(uv * 1.2 + 2.2 * w) - 0.2) * 3.6, 0.0, 1.0);
    float3 c = mix(float3(0.86, 0.98, 0.93), float3(0.48, 0.88, 0.72), smoothstep(0.2, 0.8, f));
    c = mix(c, float3(0.30, 0.78, 0.72), smoothstep(0.65, 1.0, f) * 0.55);
    c = mix(c, float3(0.70, 0.92, 1.0), smoothstep(0.3, 0.48, w.y) * 0.4);
    c += 0.08 * pow(smoothstep(0.5, 0.9, f), 3.0);
    float2 bp = uv * 6.0 + float2(sin(t * 0.1) * 0.5, -t * 0.12);
    float2 bi = floor(bp);
    float h = hash(bi);
    float d = length(fract(bp) - 0.5 - (hash2(bi) - 0.5) * 0.3);
    float r = 0.1 + h * 0.25;
    c = mix(c, float3(1.0), (smoothstep(r, r - 0.03, d) - smoothstep(r - 0.03, r - 0.08, d)) * step(h, 0.25) * 0.7);
    return outc(c);
}
