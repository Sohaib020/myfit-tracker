// Arctic Light (light): icy white, crystalline facet lines, glacier-blue and cobalt glows, sparkle
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.965, 0.980, 0.995), float3(0.910, 0.940, 0.975), uv.y);
    float r1 = length(p - float2(ar * 0.0, 0.0));
    c = mix(c, float3(0.68, 0.78, 0.98), exp(-r1 * r1 * 5.0) * 0.55);
    float r2 = length(p - float2(ar * 1.0, 0.62));
    c = mix(c, float3(0.76, 0.91, 0.98), exp(-r2 * r2 * 5.0) * 0.55);
    float r3 = length(p - float2(ar * 0.25, 1.05));
    c = mix(c, float3(0.80, 0.86, 1.0), exp(-r3 * r3 * 6.0) * 0.40);
    // crystal facets: three line families at 60 degrees, shown only in patches
    float px = 1.0 / res.y;
    float a1 = p.x * 0.866 + p.y * 0.5;
    float a2 = -p.x * 0.866 + p.y * 0.5;
    float a3 = p.y;
    float s = 6.0;
    float l1 = smoothstep(px * s * 1.5, 0.0, abs(fract(a1 * s + 0.2) - 0.5) - 0.5 + px * s * 1.5);
    float l2 = smoothstep(px * s * 1.5, 0.0, abs(fract(a2 * s * 1.3 + 0.6) - 0.5) - 0.5 + px * s * 1.5);
    float l3 = smoothstep(px * s * 1.5, 0.0, abs(fract(a3 * s * 0.8 + 0.1) - 0.5) - 0.5 + px * s * 1.5);
    float m1 = smoothstep(0.55, 0.62, noise(p * 3.0 + 1.0));
    float m2 = smoothstep(0.55, 0.62, noise(p * 3.0 + 7.0));
    float m3 = smoothstep(0.58, 0.65, noise(p * 3.0 + 13.0));
    float facet = (1.0 - l1) * m1 + (1.0 - l2) * m2 + (1.0 - l3) * m3;
    c = mix(c, float3(1.0, 1.0, 1.0), clamp(facet, 0.0, 1.0) * 0.6);
    c = mix(c, float3(0.86, 0.92, 1.0), (m1 * 0.5 + m2 * 0.3) * 0.25);
    // sparkle
    c += float3(1.0, 1.0, 1.0) * stars(p * 60.0, 0.10, 0.0) * 0.35;
    float d = (p.x * 0.6 + p.y * 0.8 - 0.55) / 0.12;
    c = mix(c, float3(1.0, 1.0, 1.0), exp(-d * d) * 0.30);
    c += (hash(fc + 1.1) - 0.5) * 0.008;
    return outc(c);
}
