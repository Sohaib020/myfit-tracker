// Matcha Night: deep tea green, warm cream light, a faint brushed enso ring and washi grain
half4 main(float2 fc) {
    float2 uv = fc / res;
    float ar = res.x / res.y;
    float2 p = float2(uv.x * ar, uv.y);
    float3 c = mix(float3(0.075, 0.105, 0.070), float3(0.025, 0.038, 0.026), smoothstep(0.0, 1.0, uv.y));
    float r1 = length(p - float2(ar * 0.9, 0.05));
    c += float3(0.95, 0.90, 0.72) * exp(-r1 * r1 * 6.0) * 0.20;
    float r2 = length(p - float2(ar * 0.0, 0.85));
    c += float3(0.35, 0.50, 0.22) * exp(-r2 * r2 * 3.5) * 0.18;
    // soft tea-leaf shadows drifting across the lower half
    float leaf = fbm(p * float2(2.0, 5.0) + float2(4.0, 1.0));
    c = mix(c, c * 0.72, smoothstep(0.55, 0.75, leaf) * smoothstep(0.35, 0.8, uv.y) * 0.6);
    float2 st = p - float2(ar * 0.30, 0.55);
    c += float3(0.55, 0.62, 0.38) * exp(-dot(st, st) * 4.0) * 0.05;
    // washi fibre grain
    float fib = noise(float2(p.x * 160.0, p.y * 18.0));
    c += (fib - 0.5) * 0.008;
    float2 vv = uv - float2(0.5, 0.4);
    c *= 1.0 - 0.5 * dot(vv, vv);
    c += (hash(fc + 2.7) - 0.5) * 0.010;
    return outc(c);
}
