uniform float2 res;
uniform float t;

float hash(float2 p) {
    p = fract(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
}
float2 hash2(float2 p) {
    float n = hash(p);
    return float2(n, hash(p + n + 17.17));
}
float noise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(hash(i), hash(i + float2(1.0, 0.0)), u.x),
               mix(hash(i + float2(0.0, 1.0)), hash(i + float2(1.0, 1.0)), u.x), u.y);
}
float fbm(float2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * noise(p);
        p = p * 2.03 + float2(1.7, 9.2);
        a *= 0.5;
    }
    return v;
}
float fbm3(float2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 3; i++) {
        v += a * noise(p);
        p = p * 2.07 + float2(5.1, 1.3);
        a *= 0.5;
    }
    return v;
}
// soft round particle field: returns brightness of particles in a grid of cells
float stars(float2 p, float density, float tw) {
    float2 i = floor(p);
    float2 f = fract(p) - 0.5;
    float h = hash(i);
    if (h > density) return 0.0;
    float2 o = hash2(i + 3.1) - 0.5;
    float d = length(f - o * 0.7);
    float twinkle = 0.55 + 0.45 * sin(t * (1.0 + h * 3.0) * tw + h * 40.0);
    return smoothstep(0.08, 0.0, d) * twinkle;
}
half4 outc(float3 c) { return half4(half3(clamp(c, 0.0, 1.0)), 1.0); }
