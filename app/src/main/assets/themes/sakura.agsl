// Sakura rain: pink petals tumbling over a soft blossom gradient (light theme)
half4 main(float2 fc) {
    float2 uv = fc / res.y;
    float v = fc.y / res.y;
    float3 c = mix(float3(1.0, 0.95, 0.97), float3(0.98, 0.78, 0.85), v);
    c = mix(c, float3(1.0, 0.86, 0.92), fbm3(uv * 1.5 + t * 0.03) * 0.5);
    // blurred blossom clusters top corners
    float bl = fbm(uv * 4.0 + 2.0);
    c = mix(c, float3(1.0, 0.62, 0.76), smoothstep(0.55, 0.75, bl) * smoothstep(0.45, 0.0, v) * 0.6);
    // petals: 3 layers of falling cells
    for (int L = 0; L < 3; L++) {
        float fl = float(L);
        float sc = 5.0 + fl * 3.0;
        float2 p = uv * sc + float2(t * (0.25 + fl * 0.08), -t * (0.6 + fl * 0.2));
        float2 i = floor(p);
        float2 f = fract(p) - 0.5;
        float h = hash(i + fl * 13.0);
        if (h < 0.35) {
            float2 o = (hash2(i) - 0.5) * 0.5;
            float a = t * (1.0 + h * 2.0) + h * 6.28;
            float2 q = f - o;
            q = float2(q.x * cos(a) - q.y * sin(a), q.x * sin(a) + q.y * cos(a));
            q.x *= 1.0 + 0.6 * abs(sin(a * 0.7));
            float petal = smoothstep(0.16, 0.12, length(q * float2(1.0, 1.8)));
            float3 pc = mix(float3(1.0, 0.55, 0.72), float3(1.0, 0.8, 0.88), h * 2.0);
            c = mix(c, pc, petal * (0.55 + fl * 0.15));
        }
    }
    return outc(c);
}
